{
    "name": "propel/propel",
    "type": "library",
    "description": "Propel2 is an open-source Object-Relational Mapping (ORM) for PHP.",
    "keywords": ["ORM", "persistence", "Active Record"],
    "homepage": "http://www.propelorm.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "William Durand",
            "email": "william.durand1@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/log": "^3.0",
        "symfony/yaml": "~7.0.0",
        "symfony/config": "~7.0.0",
        "symfony/console": "~7.0.0",
        "symfony/filesystem": "~7.0.0",
        "symfony/finder": "~7.0.0",
        "symfony/translation": "~7.0.0",
        "symfony/validator": "~7.0.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-xml": "*",
        "monolog/monolog": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "spryker/code-sniffer": "^0.17.2",
        "psalm/phar": "^5.0 || ^6.0",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Propel\\": "src/Propel/"
        }
    },
    "bin": ["bin/propel"],
    "extra": {
        "branch-alias": {
            "dev-master": "3.0-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
