includes:
    - phpstan-baseline.neon
parameters:
    level: 7
    phpVersion: 80300
    reportUnmatchedIgnoredErrors: false
    paths:
        - '%rootDir%/../../../src/'
    ignoreErrors:
        # The 4 prior blanket regex were dropped per umbrella §4.1 Phase A.32
        # baseline-drawdown contract. Errors they hid now surface in the
        # baseline file (still suppressed for now, but counted and gated by
        # the monotonic CI check, so they can only shrink from here).
        # Blanket regex are re-introduced only with maintainer sign-off.
        -
            identifier: missingType.iterableValue
